# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
BOT_NAME=aigarth
# Channels the bot actively responds in (comma-separated IDs; empty = any)
BOT_CHANNELS=
# Channels it stores history from but never responds in
BOT_READONLY_CHANNELS=
# Admins (comma-separated user IDs) for !chattiness / !remember / doc commands
ADMIN_USER_IDS=
# ── The Grid (the agent's brain — dogfooding our own /v1) ─
GRID_API_KEY=your_grid_api_key
GRID_V1_URL=https://api.aipowergrid.io/v1
GRID_CHAT_MODEL=qwen3-27b
# Background context compression only, never a participation judge.
GRID_SUMMARY_MODEL=qwen3-27b
GRID_CONTEXT_WINDOW=32000
GRID_MAX_TOKENS=4096
CHAT_REPETITION_PENALTY=1
CHAT_FREQUENCY_PENALTY=0
CHAT_PRESENCE_PENALTY=0

# ── Image generation (Grid v1) ───────────────────────────
GRID_IMAGE_BASE_URL=https://api.aipowergrid.io
# Public Grid v1 status host (worker counts, models, queue)
GRID_STATUS_URL=https://api.aipowergrid.io

# ── Vision (describe_image) — SEPARATE image-capable model ─
# Empty disables the skill. Must be a multimodal model the grid /v1 serves.
GRID_VISION_MODEL=
# Optional: a different /v1 base for vision (defaults to GRID_V1_URL)
GRID_VISION_V1_URL=

# ── Doc RAG retrieval microservice (Python, ChromaDB) ────
RETRIEVAL_URL=http://127.0.0.1:8088
RETRIEVAL_API_KEY=

# ── Agent memory (hindsight; optional — no-op if unset) ──
# Run hindsight (Docker) and point this at it. Configure hindsight's own LLM at
# our grid /v1 so reflection is dogfooded.
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=aigarth

# ── Crypto skill (CoinGecko) ─────────────────────────────
COINGECKO_API_KEY=
COINGECKO_PRO=false

# ── State + behavior ─────────────────────────────────────
STATE_DB_PATH=./aigarth.db
HISTORY_WINDOW=20
HISTORY_MAX_CHARS=24000
DISCORD_CONTEXT_LIMIT=50
SUMMARY_MIN_BATCH=8
SUMMARY_BATCH_SIZE=40
SUMMARY_MAX_CHARS=4000
SUMMARY_TIMEOUT_MS=60000
AUTO_MEMORY_ENABLED=true
USER_MEMORY_MAX=30
# AI proposals: moderator buttons or eligible moderator reaction quorum.
# Ban Members required for ban votes; Manage Messages for delete votes.
# ✅ votes needed to enact; ❌ votes to dismiss. Ordinary member reactions do not count.
BAN_VOTE_THRESHOLD=4
DISMISS_VOTE_THRESHOLD=3
BAN_VOTE_TTL_MS=86400000
# Backward-compatible outcome for legacy persisted action="moderate" votes.
# New start_ban_poll votes always ban.
SCAM_OUTCOME=timeout
