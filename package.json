{
  "name": "aigarth-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Aigarth — AI Power Grid community agent. Built on the pi agent core, running entirely on the Grid's own /v1 (dogfooding). Tools are skills: image generation, doc search.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && DISCORD_TOKEN=x GRID_API_KEY=x node --test $(find dist -name '*.test.js')",
    "eval": "tsc -p tsconfig.json && node dist/eval.js",
    "smoke": "tsc -p tsconfig.json && node dist/smoke.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.4",
    "@earendil-works/pi-ai": "^0.79.4",
    "@vectorize-io/hindsight-client": "^0.8.2",
    "better-sqlite3": "^11.8.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3"
  }
}
